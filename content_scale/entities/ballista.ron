        Move(( speed_milli_tiles_per_s: 1200, radius_milli_tiles: 450 )),
        Attack(( damage: 60, range_milli_tiles: 12000, cooldown_ms: 4000, acquire_range_milli_tiles: 12500 )),
        Vision(( radius_milli_tiles: 12500 )),
    ],
    cost: ( ore: 275 ),
    build_time_ms: 32000,
    population: 3,
    requires: [ "forge" ],
)
