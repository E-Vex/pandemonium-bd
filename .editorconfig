# EditorConfig is the universal source-of-truth for editor behavior:
# https://editorconfig.org. cargo fmt remains the source of truth for
# Rust formatting; this file makes non-Rust files (TOML, YAML, Markdown,
# RON content) consistent across VS Code, JetBrains, vim, emacs, etc.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{rs,toml,yml,yaml}]
indent_size = 4

[*.md]
indent_size = 2
# Markdown's two-trailing-space line break is intentional prose; preserve it.
trim_trailing_whitespace = false

[*.{ron,json}]
indent_size = 2

[Makefile]
indent_style = tab
