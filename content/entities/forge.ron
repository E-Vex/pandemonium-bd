// The Forge (B-029, plan §19's expansion test — Update 2, data-only): 3x3
// tech-production structure; the Legion's second tier. Fielding the
// Pathfinder, Lancer, and Ballista requires raising one (the production
// list is faction data — factions/legion.ron; the trainable list is
// capped at three by the command card's per-producer row, M10.2 §2.3).
// B-034 (plan §19 Update 7 — the upgrade system, ADR-0203): the research
// home. Two upgrades live here — Weapon Systems (+25% damage for the
// rifle line) and, chained on it, Field Engines (+15% speed for the
// logistics line). Researching costs the purse and occupies the Forge's
// single project slot; completion is permanent and player-wide — the
// upgrade survives even this building's death.
//
// Authoring note: the id sorts AFTER "barracks" in the faction's
// production map (producers iterate in sorted order), and the scripted
// AI's plan resolution (engine ai_host: "Roster from the faction's
// production lists") takes the FIRST producer whose list carries
// attackers — the barracks. The Forge is invisible to the Alpha opponent
// by construction; that property is pinned by tests/ai.rs
// (the_alpha_plan_ignores_the_forge). The scripted plan never builds,
// trains from, or researches at a Forge — so no pinned run ever sees the
// Upgrades capability or a Research command (A-239, the A-234 rule).
(
    schema_version: 1,
    id: "forge",
    display_name: "Forge",
    capabilities: [
        Health(( max: 750 )),
        Vision(( radius_milli_tiles: 8000 )),
        Footprint(( w: 3, h: 3 )),
        Produce(()),
        Upgrades(( upgrades: [
            ( id: "weapon_systems", display_name: "Weapon Systems",
              effect: AttackDamage(( multiplier_milli: 1250, targets: [ "rifleman", "raider" ] )),
              research_time_ms: 20000, cost_ore: 250, requires: [] ),
            ( id: "field_engines", display_name: "Field Engines",
              effect: MoveSpeed(( multiplier_milli: 1150, targets: [ "worker", "pathfinder" ] )),
              research_time_ms: 15000, cost_ore: 200, requires: [ "weapon_systems" ] ),
        ] )),
    ],
    cost: ( ore: 250 ),
    build_time_ms: 30000,
    population: 0,
    requires: [ "barracks" ],
)
